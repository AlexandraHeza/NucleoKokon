# ------------------------------------------------------------------
# Núcleo Kokón — variables de entorno del frontend
# Solo VITE_* llega al bundle del navegador: nunca pongas secretos aquí.
# ------------------------------------------------------------------

# Base URL del backend. Vacío = mismo origen (útil detrás de proxy).
VITE_API_URL=http://localhost:4000

# Modo desarrollo: abre /health del backend y muestra errores legibles
VITE_DEV_TOOLS=false

// Núcleo Kokón — modelo de datos
// RF-001, RF-002, RF-003, RF-005

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Plan comercial de la usuaria (modelo freemium).
enum Plan {
  free
  base
  premium
}

/// Rol y permisos dentro de la plataforma.
enum Role {
  user
  mentor
  admin
}

model User {
  id                 String  @id @default(uuid()) @db.Uuid
  email              String  @unique @db.VarChar(255)
  passwordHash       String  @map("password_hash") @db.VarChar(255)
  nombre             String  @db.VarChar(120)
  plan               Plan    @default(free)
  rol                Role    @default(user)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  resetPasswordToken String?   @unique @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Sesiones activas. El refresh token se guarda hasheado (sha256) para
/// poder revocar una sesión concreta en el logout sin guardar el JWT en claro.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

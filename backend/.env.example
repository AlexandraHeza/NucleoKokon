# ------------------------------------------------------------------
# Núcleo Kokón — variables de entorno del backend
# Copia este archivo a `.env` y reemplaza los valores.
# NUNCA subas el `.env` real al repositorio.
# ------------------------------------------------------------------

# Entorno: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL (host interno de Docker: `db`)
DATABASE_URL="postgresql://kokon:kokon_dev_password@localhost:5432/nucleo_kokon?schema=public"

# JWT — genera secretos con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_en_produccion
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_en_produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Cookie httpOnly del refresh token
REFRESH_COOKIE_NAME=kk_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# CORS — origenes permitidos separados por coma
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
